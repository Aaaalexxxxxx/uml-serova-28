@startuml
!include ../../_style.puml
title Служба такси: модель предметной области
hide circle

' ============================================================
' ПАКЕТ 1: ПОЛЬЗОВАТЕЛИ
' ============================================================
package "users" {

    abstract class Пользователь {
        + id : UUID
        + телефон : String
        + рейтинг : Float
        + {abstract} описаниеРоли() : String
    }

    class Клиент {
        + имя : String
        + заблокирован : Boolean
        + долг : Decimal
        + оставитьОтзыв(оценка : Int) : void
    }

    class Водитель {
        + имя : String
        + авто : String
        + статус : СтатусВодителя
        + геолокация : Координаты
        + приоритет : Int
        + принятьЗаказ(заказ : Заказ) : Boolean
    }

    enum СтатусВодителя {
        СВОБОДЕН
        ЗАНЯТ
        ОТДЫХ
        ЗАБЛОКИРОВАН
    }

    Пользователь <|-- Клиент
    Пользователь <|-- Водитель
}

' ============================================================
' ПАКЕТ 2: ЗАКАЗЫ
' ============================================================
package "orders" {

    class Заказ {
        + id : UUID
        + адресПодачи : String
        + адресНазначения : String
        + статус : СтатусЗаказа
        + времяСоздания : DateTime
        + стоимость : Decimal
        + радиусПоиска : Float
    }

    class Поездка {
        + id : UUID
        + координаты : Координаты
        + расстояние : Float
        + времяНачала : DateTime
        + времяОкончания : DateTime
    }

    class Предложение {
        + id : UUID
        + времяОтправки : DateTime
        + таймаут : Int
        + принято : Boolean
    }

    class Тариф {
        + название : String
        + базоваяЦена : Decimal
        + коэффициентСпроса : Float
        + рассчитатьСтоимость(расстояние : Float) : Decimal
    }

    class Отзыв {
        + оценка : Int
        + комментарий : String
        + дата : DateTime
    }

    enum СтатусЗаказа {
        СОЗДАН
        ПОДБОР_ВОДИТЕЛЯ
        ВОДИТЕЛЬ_НАЗНАЧЕН
        В_ПУТИ
        ЗАВЕРШЁН
        ОТМЕНЁН
    }

    Заказ "1" *-- "0..1" Поездка : композиция
    Заказ "1" o-- "0..*" Предложение : агрегация
    Заказ "1" --> "1" Тариф : использует
    Заказ "1" o-- "0..2" Отзыв : агрегация
}

' ============================================================
' ПАКЕТ 3: ПЛАТЕЖИ И ВНЕШНИЕ СИСТЕМЫ
' ============================================================
package "integration" {

    class Транзакция {
        + id : UUID
        + сумма : Decimal
        + резерв : Decimal
        + статус : СтатусТранзакции
        + провести() : Boolean
    }

    class ПлатёжныйШлюз <<external>> {
        + apiUrl : String
        + таймаут : Int
        + провестиПлатёж(сумма : Decimal) : Boolean
    }

    class КартографическийСервис <<external>> {
        + apiUrl : String
        + таймаут : Int
        + рассчитатьМаршрут(от : String, до : String) : Float
    }

    enum СтатусТранзакции {
        СОЗДАНА
        ПРОВЕДЕНА
        ОТМЕНЕНА
    }

    Транзакция --> ПлатёжныйШлюз : использует
}

' ============================================================
' ЗАВИСИМОСТИ МЕЖДУ ПАКЕТАМИ
' ============================================================
orders ..> users : <<use>>
orders ..> integration : <<use>>
integration ..> orders : <<use>>

' ============================================================
' СВЯЗИ МЕЖДУ КЛАССАМИ РАЗНЫХ ПАКЕТОВ
' ============================================================
Клиент "1" -- "0..*" Заказ : создаёт
Водитель "1" -- "0..*" Поездка : выполняет
Водитель "1" -- "0..*" Предложение : получает
Заказ "1" -- "1" Транзакция : оплачивается

@enduml