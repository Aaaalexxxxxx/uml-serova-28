System_Ext(maps, "Картографический сервис", "Геокодирование адресов, расчёт маршрута и расстояния")

Rel(client, taxi, "Заказывает и отменяет поездку, оценивает водителя", "HTTPS")
Rel(driver, taxi, "Принимает заказ, завершает поездку, оценивает клиента", "HTTPS")
Rel(dispatcher, taxi, "Разрешает споры между клиентом и водителем", "HTTPS")
Rel(taxi, pay, "Проводит оплату и возврат средств", "HTTPS")
Rel(taxi, maps, "Запрашивает координаты и расстояние", "HTTPS")

SHOW_LEGEND()

