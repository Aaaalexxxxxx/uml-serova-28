@startuml
!include <C4/C4_Context>

title Уровень 1 — System Context: Служба такси

Person(client, "Клиент", "Заказывает поездку, оплачивает, оценивает водителя")
Person(driver, "Водитель", "Принимает заказы, выполняет поездки, оценивает клиента")
Person(dispatcher, "Диспетчер", "Разрешает споры между клиентом и водителем")

System(taxi, "Служба такси", "Заказ поездок, подбор водителей, динамическое ценообразование, оплата, отзывы")

