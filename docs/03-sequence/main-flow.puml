@startuml
!include ../../_style.puml

title ВИ-01 «Заказать поездку»: основной сценарий

actor "Клиент" as client
participant "МобильноеПриложение" as ui
participant "RideService" as svc
participant "ТарифнаяПолитика" as policy
participant "DriverService" as drv
database "БД" as db

client -> ui : указать(точкаА, точкаБ, класс)
activate ui

ui -> svc : рассчитатьПоездку(точкаА, точкаБ, класс)
activate svc

svc -> policy : тарифДля(класс)
activate policy
policy --> svc : Тариф
deactivate policy

svc -> svc : рассчитатьСтоимость(маршрут, тариф)

svc -> db : SELECT доступные водители
activate db
db --> svc : список водителей
deactivate db

opt водители найдены
    svc -> drv : назначитьВодителя(заказ, список)
    activate drv
    drv -> db : INSERT ride
    activate db
    db --> drv : id поездки
    deactivate db
    drv --> svc : Водитель
    deactivate drv
end

svc --> ui : Поездка
deactivate svc

ui --> client : стоимость и время подачи
deactivate ui

@enduml
